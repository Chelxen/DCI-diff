{
    "name": "train_GE_raw_diff_uncertainty",
    "phase": "train",
    "raw_data": true,
    "data_range": 4.0,
    "uncertainty_checkpoint_dir": "checkpoints/GE_raw_uncertainty_120",
    "gpu_ids": [
        0
    ],
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },
    "model": {
        "which_model_G": "ddpm", 
        "finetune_norm": false,
        "unet": {
            "in_channel": 2,
            "out_channel": 1,
            "inner_channel": 64,
            "channel_multiplier": [
                1,
                1,
                2,
                2,
                4
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 2,
            "dropout": 0
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear",
                "n_timestep": 500,
                "linear_start": 1e-4,
                "linear_end": 2e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 500,
                "linear_start": 1e-4,
                "linear_end": 2e-2
            }
        },
        "diffusion": {
            "image_size": 256,
            "channels": 2, 
            "conditional": true,
            "cond_prob": 0.8
        }
    },
    "train": {
        "n_iter": 400000,
        "val_freq": 10000,
        "save_checkpoint_freq": 10000,
        "print_freq": 100,
        "optimizer": {
            "type": "adam",
            "lr": 1e-4
        },
        "ema_scheduler": {
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "GSR"
    }
}
